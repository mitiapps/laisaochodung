      },
      "wrong-way": {
        "vi": "{vehicle} đi ngược chiều va vào bạn. Trò chơi không ghi nhận lỗi của bạn, không trừ điểm."
      },
      "no-yield": {
        "vi": "{vehicle} không nhường đường va vào bạn. Trò chơi không ghi nhận lỗi của bạn, không trừ điểm."
      },
      "unsafe-lane-change": {
        "vi": "{vehicle} chuyển làn ẩu va vào bạn. Trò chơi không ghi nhận lỗi của bạn, không trừ điểm."
      },
      "speeding": {
        "vi": "{vehicle} chạy quá tốc độ va vào bạn. Trò chơi không ghi nhận lỗi của bạn, không trừ điểm."
      },
      "tailgating": {
        "vi": "{vehicle} không giữ khoảng cách an toàn va vào bạn. Trò chơi không ghi nhận lỗi của bạn, không trừ điểm."
      },
      "from-behind": {
        "vi": "Xe khác va vào bạn từ phía sau. Trò chơi không ghi nhận lỗi của bạn, không trừ điểm."
      },
      "none": {
        "vi": "{vehicle} va vào bạn. Trò chơi không ghi nhận lỗi của bạn, không trừ điểm."
      },
      "aftermath": {
        "vi": "Va chạm tiếp theo sau khi bạn bị xe khác va vào. Trò chơi không ghi nhận lỗi của bạn, không trừ điểm."
      },
      "ego-slow": {
        "vi": "Bạn chạm nhẹ vào {vehicle} ở tốc độ rất thấp. Trò chơi không trừ điểm; hãy giữ khoảng cách an toàn."
      },
      "pedestrian-slow": {
        "vi": "Có va chạm nhẹ với người đi bộ ở tốc độ rất thấp. Trò chơi không trừ điểm; hãy dừng hẳn và nhường đường cho người đi bộ."
      }
    }
